{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Argus-C2 signed read-only task payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "request_id", "agent_id", "enrollment_epoch", "created_at", "expires_at", "task_type", "task_version", "params", "actor_id", "policy_digest"],
  "properties": {
    "version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "agent_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "enrollment_epoch": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "created_at": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "expires_at": {"type": "integer", "minimum": 2, "maximum": 9223372036854775807},
    "task_type": {"enum": ["system.info", "system.metrics", "ssh.audit", "service.status"]},
    "task_version": {"const": 1},
    "params": {"type": "object"},
    "actor_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"task_type": {"enum": ["system.info", "system.metrics"]}}}, "then": {"properties": {"params": {"maxProperties": 0}}}},
    {"if": {"properties": {"task_type": {"const": "ssh.audit"}}}, "then": {"properties": {"params": {"additionalProperties": false, "required": ["profile_id"], "properties": {"profile_id": {"$ref": "#/$defs/resource_id"}}}}}},
    {"if": {"properties": {"task_type": {"const": "service.status"}}}, "then": {"properties": {"params": {"additionalProperties": false, "required": ["service_id"], "properties": {"service_id": {"$ref": "#/$defs/resource_id"}}}}}}
  ],
  "$defs": {"resource_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"}},
  "$comment": "System tasks have empty params. Inspection tasks select one locally mapped ID; no paths or unit names travel in tasks. Go validation additionally enforces byte/depth bounds, exact integers, duplicate-key and Unicode rejection, and a validity window of at most 300 seconds. Target/time/policy checks are separate. This schema does not authorize execution."
}
