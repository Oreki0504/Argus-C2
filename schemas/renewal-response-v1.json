{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Argus-C2 certificate renewal response",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "renewal_id", "agent_id", "enrollment_epoch", "generation", "previous_certificate_sha256", "previous_valid_until", "certificate_pem"],
  "properties": {
    "version": {"const": 1},
    "renewal_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "agent_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "enrollment_epoch": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "generation": {"type": "integer", "minimum": 2, "maximum": 64},
    "previous_certificate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previous_valid_until": {"type": "integer", "minimum": 1},
    "certificate_pem": {"type": "string", "minLength": 1, "maxLength": 12000}
  },
  "$comment": "At most 16384 response bytes. The client additionally verifies the old fingerprint, renewal ID, node and epoch, staged private-key match, client-only certificate profile, pinned CA chain, bounded lifetime, and bounded overlap. No root, policy, path, or server destination can be returned."
}
