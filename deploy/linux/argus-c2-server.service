[Unit]
Description=Argus-C2 administration and probe server
Documentation=https://github.com/Oreki0504/Argus-C2
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
User=argus-server
Group=argus-server
WorkingDirectory=/var/lib/argus-c2-server
ReadWritePaths=/var/lib/argus-c2-server
NoExecPaths=/var/lib/argus-c2-server /tmp /var/tmp
LoadCredential=server-key:/etc/argus-c2/server/secrets/server-key.pem
LoadCredential=task-key:/etc/argus-c2/server/secrets/task-private.pem
ExecStartPre=/usr/bin/test -f /var/lib/argus-c2-server/argus.db
ExecStart=/usr/local/libexec/argus-c2/server -listen 127.0.0.1:8443 -admin-listen 127.0.0.1:8445 -cert /etc/argus-c2/server/server-cert.pem -key %d/server-key -ca /etc/argus-c2/server/ca.pem -state /var/lib/argus-c2-server -task-signing-key %d/task-key
Type=exec
UMask=0077
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=1024
LimitCORE=0
TasksMax=128
MemorySwapMax=0
OOMPolicy=stop
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
CPUQuota=100%
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
