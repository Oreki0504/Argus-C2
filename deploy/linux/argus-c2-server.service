[Unit]
Description=Argus Linux fleet diagnostics server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=argus-server
Group=argus-server
UMask=0077
StateDirectory=argus-c2-server
StateDirectoryMode=0700
LoadCredential=server-key:/etc/argus-c2/server/server-key.pem
LoadCredential=issuer-key:/etc/argus-c2/server/ca-key.pem
LoadCredential=admins:/etc/argus-c2/server/admins.json
ExecStart=/usr/local/libexec/argus-c2/server run -config /etc/argus-c2/server.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/argus-c2-server
NoExecPaths=/var/lib/argus-c2-server /tmp /var/tmp
LimitNOFILE=2048
LimitCORE=0
TasksMax=128
MemoryMax=256M
MemorySwapMax=0
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
