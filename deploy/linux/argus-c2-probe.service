[Unit]
Description=Argus-C2 read-only node probe
Documentation=https://github.com/Oreki0504/Argus-C2
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
User=argus-probe
Group=argus-probe
WorkingDirectory=/var/lib/argus-c2-probe
ReadWritePaths=/var/lib/argus-c2-probe
NoExecPaths=/var/lib/argus-c2-probe /tmp /var/tmp
LoadCredential=probe-key:/etc/argus-c2/probe/secrets/probe-key.pem
ExecStartPre=/usr/bin/test -f /var/lib/argus-c2-probe/replay/probe.db
ExecStart=/usr/local/libexec/argus-c2/agent -server https://127.0.0.1:8443 -cert /etc/argus-c2/probe/probe-cert.pem -key %d/probe-key -ca /etc/argus-c2/probe/ca.pem -identity /etc/argus-c2/probe/identity.json -policy /etc/argus-c2/probe/policy.json -task-state /var/lib/argus-c2-probe/replay -task-public-key /etc/argus-c2/probe/task-public.pem
Type=exec
UMask=0077
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
# systemd 255 blocks openat2 under this switch; safe SSH reads require openat2.
# Keep NoNewPrivileges, empty capabilities, and all other restrictions enabled.
RestrictSUIDSGID=false
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=1024
LimitCORE=0
TasksMax=128
MemorySwapMax=0
OOMPolicy=stop
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
CPUQuota=50%
MemoryHigh=128M
MemoryMax=192M

[Install]
WantedBy=multi-user.target
